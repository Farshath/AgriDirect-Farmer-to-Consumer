# Environment Configuration for Farmer-to-Consumer Agri Marketplace
PORT=5050
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas or Local Connection String
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/agri_marketplace?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/agri_marketplace
MONGODB_URI=mongodb://127.0.0.1:27017/agri_marketplace

# JWT Secret Configuration
JWT_SECRET=agri_marketplace_super_secret_jwt_key_2026_farm_to_table_secure
JWT_EXPIRES_IN=7d

# Optional Cloudinary Configuration (App gracefully falls back to local uploads if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial Admin Credentials (Used by seed script)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@agrimarket.com
ADMIN_PASSWORD=Admin@12345
